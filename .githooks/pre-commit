#!/bin/sh
set -eu

# Allow project source, docs, schemas, evidence images, and JSONL fixtures
# (episode_results / frames).
excluded_files="$(
  git diff --cached --name-only --diff-filter=ACM |
    grep -vE '(^LICENSE$|^\.githooks/pre-commit$|^\.gitignore$|\.gitkeep$|\.py$|\.jsonl?$|\.ya?ml$|\.txt$|\.md$|\.gif$|\.jpe?g$|\.png$|\.svg$|\.mp4$|\.ipynb$|\.urdf$|\.sh$|^bin/)' ||
    true
)"

if [ -n "$excluded_files" ]; then
  echo "Error: Only source code files are allowed to commit. The following non-code files were staged:"
  echo "$excluded_files"
  exit 1
fi
