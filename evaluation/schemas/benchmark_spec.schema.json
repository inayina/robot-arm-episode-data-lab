{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-arm-episode-data-lab.local/schemas/evaluation/benchmark_spec.schema.json",
  "title": "Single-block controlled benchmark spec (v0 subset)",
  "description": "Machine-readable benchmark slices. Execution of OOD is gated; this schema only validates the spec.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "benchmark_version",
    "task",
    "robot",
    "action_schema_version",
    "hard_gate",
    "slices"
  ],
  "properties": {
    "contract_version": {"const": "benchmark_spec_v0"},
    "artifact_type": {"const": "benchmark_spec"},
    "benchmark_version": {"const": "single_block_controlled_v0"},
    "task": {"const": "pick_specified_block_place_fixed_bin"},
    "robot": {"const": "panda"},
    "action_schema_version": {"const": "panda_ee_delta_gripper_v0"},
    "observation_schema_ref": {"type": "string", "minLength": 1},
    "hard_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_learned_policy_lift_before_ood",
        "current_learned_policy_lift_verified",
        "allowed_now",
        "forbidden_now"
      ],
      "properties": {
        "require_learned_policy_lift_before_ood": {"type": "boolean"},
        "current_learned_policy_lift_verified": {"type": "boolean"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_now": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "forbidden_now": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "factors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "id", "ood_position"],
      "properties": {
        "baseline": {"$ref": "#/$defs/slice"},
        "id": {"$ref": "#/$defs/slice"},
        "ood_position": {"$ref": "#/$defs/slice"}
      }
    },
    "leakage_rules": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_lanes", "task_authority", "interface_pass_is_not_task_pass"],
      "properties": {
        "metric_lanes": {
          "type": "array",
          "items": {
            "enum": ["data", "offline", "interface", "behavior", "task", "system"]
          }
        },
        "task_authority": {"const": "upstream_runtime_ground_truth"},
        "interface_pass_is_not_task_pass": {"const": true}
      }
    }
  },
  "$defs": {
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "benchmark_exclusive",
        "min_rollouts",
        "episode_suite_id_map",
        "enabled"
      ],
      "properties": {
        "slice_id": {
          "enum": ["baseline", "id", "ood_position"]
        },
        "split_role": {
          "type": "array",
          "items": {"type": "string"}
        },
        "benchmark_exclusive": {"type": "boolean"},
        "train_allowed": {"type": "boolean"},
        "validation_allowed": {"type": "boolean"},
        "min_rollouts": {"type": "integer", "minimum": 1},
        "suggested_seeds": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "suggested_seed_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 0}
        },
        "held_out_factors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "episode_suite_id_map": {
          "enum": ["nominal", "object_pose", "visual", "camera", "dynamics"]
        },
        "enabled": {"type": "boolean"},
        "enabled_when": {"type": ["string", "null"]},
        "go_no_go": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
