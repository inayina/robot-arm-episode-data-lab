{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-arm-episode-data-lab.local/schemas/evaluation/unified_eval_report.schema.json",
  "title": "Unified evaluation report v0",
  "description": "Minimal cross-backend evaluation envelope. Remaps existing open-loop / PolicyRunner / Isaac S4 evidence. Does not authorize task success or Sim2Real.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_type",
    "evaluation_run_id",
    "backend_id",
    "claims_task_success",
    "claims_sim2real",
    "claims_online_autonomous_grasp",
    "failure_lane",
    "columns",
    "source",
    "non_claims"
  ],
  "properties": {
    "contract_version": {"const": "unified_eval_report_v0"},
    "artifact_type": {"const": "unified_eval_report"},
    "evaluation_run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
    },
    "backend_id": {
      "enum": [
        "smolvla_open_loop",
        "downstream_policy_runner",
        "isaac_s4_bounded"
      ]
    },
    "gate_decision": {
      "type": ["string", "null"],
      "description": "Pass/hold/fail label from source when present; null if source has no gate."
    },
    "claims_task_success": {"const": false},
    "claims_sim2real": {"const": false},
    "claims_online_autonomous_grasp": {"const": false},
    "failure_lane": {
      "enum": [
        "none",
        "data_fail",
        "interface_fail",
        "behavior_tag",
        "task_gt",
        "system_fail"
      ]
    },
    "columns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "behavior", "task", "offline"],
      "properties": {
        "interface": {"$ref": "#/$defs/column"},
        "behavior": {"$ref": "#/$defs/column"},
        "task": {"$ref": "#/$defs/column"},
        "offline": {"$ref": "#/$defs/column"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "primary_path", "mapped_from"],
      "properties": {
        "backend_id": {
          "enum": [
            "smolvla_open_loop",
            "downstream_policy_runner",
            "isaac_s4_bounded"
          ]
        },
        "primary_path": {"type": "string", "minLength": 1},
        "companion_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mapped_from": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated", "metrics"],
      "properties": {
        "evaluated": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "description": "Only fields remapped from existing evidence; values may be null.",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean", "null"]
          }
        }
      }
    }
  }
}
